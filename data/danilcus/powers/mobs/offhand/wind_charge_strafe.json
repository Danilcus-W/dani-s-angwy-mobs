{
	"type": "origins:multiple",
	"Item":{
		"type": "origins:action_on_callback",
		"entity_action_gained": {
			"type": "origins:execute_command",
			"command": "item replace entity @s weapon.offhand with minecraft:wind_charge"
		}
	},
	"Tick": {
		"type": "origins:action_over_time",
		"interval": 30,
		"entity_action": {
			"type": "origins:chance",
			"chance": 0.6,
			"action": {
				"type": "origins:if_else",
				"condition": {
					"type": "origins:predicate",
					"predicate": "danilcus:ai_target"
				},
				"if_action": {
					"type": "origins:and",
					"actions": [
						{
							"type": "origins:chance",
							"chance": 0.5,
							"action": {
								"type": "origins:and",
								"actions": [
									{
										"type": "origins:add_velocity",
										"x": 1.0,
										"space": "local",
										"client": true,
										"server": true,
										"set": false
									},
									{
										"type": "origins:execute_command",
										"command": "tp @s ~ ~ ~ ~85 55"
									}
								]
							},
							"fail_action": {
								"type": "origins:and",
								"actions": [
									{
										"type": "origins:add_velocity",
										"x": -1.0,
										"space": "local",
										"client": true,
										"server": true,
										"set": false
									},
									{
										"type": "origins:execute_command",
										"command": "tp @s ~ ~ ~ ~-85 55"
									}
								]
							}
						},
						{
							"type": "origins:fire_projectile",
							"entity_type": "minecraft:wind_charge",
							"count": 1,
							"speed": 1.0
						},
						{
							"type": "origins:play_sound",
							"sound": "minecraft:entity.wind_charge.throw",
							"volume": 1.0,
							"pitch": 0.8
						},
						{
							"type": "origins:swing_hand"
						}
					]
				}
			}
		}
	}
}