{
	"type": "origins:multiple",
	"item":{
		"type": "origins:action_on_callback",
		"entity_action_gained": {
			"type": "origins:execute_command",
			"command": "item replace entity @s weapon.offhand with minecraft:wind_charge"
		}
	},
	"immunity":{
		"type": "origins:modify_damage_taken",
		"damage_condition": {
			"type": "origins:type",
			"damage_type": "minecraft:fall"
		},
		"modifier": {
			"operation": "set_total",
			"value": 0.0
		}
	},
	"tick": {
		"type": "origins:action_over_time",
		"interval": 5,
		"entity_action": {
			"type": "origins:chance",
			"chance": 0.2,
			"action": {
				"type": "origins:if_else",
				"condition": {
					"type": "origins:and",
					"conditions": [
						{
							"type": "origins:predicate",
							"predicate": "danilcus:ai_target"
						},
						{
							"type": "origins:resource",
							"resource": "*:*_cooldown",
							"comparison": "<=",
							"compare_to": 0
						}
					]
				},
				"if_action": {
					"type": "origins:and",
					"actions": [
						{
							"type": "origins:chance",
							"chance": 0.5,
							"action": {
								"type": "origins:and",
								"actions": [
									{
										"type": "origins:add_velocity",
										"x": 0.9,
										"space": "local",
										"client": true,
										"server": true,
										"set": false
									},
									{
										"type": "origins:execute_command",
										"command": "tp @s ~ ~ ~ ~85 50"
									}
								]
							},
							"fail_action": {
								"type": "origins:and",
								"actions": [
									{
										"type": "origins:add_velocity",
										"x": -0.9,
										"space": "local",
										"client": true,
										"server": true,
										"set": false
									},
									{
										"type": "origins:execute_command",
										"command": "tp @s ~ ~ ~ ~-85 50"
									}
								]
							}
						},
						{
							"type": "origins:fire_projectile",
							"entity_type": "minecraft:wind_charge",
							"count": 1,
							"speed": 1.0
						},
						{
							"type": "origins:trigger_cooldown",
							"power": "*:*_cooldown"
						},
						{
							"type": "origins:play_sound",
							"sound": "minecraft:entity.wind_charge.throw",
							"volume": 1.0,
							"pitch": 0.8
						},
						{
							"type": "origins:swing_hand",
							"hand": "OFF_HAND"
						}
					]
				}
			}
		}
	},
	"cooldown": {
		"type": "origins:cooldown",
		"cooldown": 20
	}
}