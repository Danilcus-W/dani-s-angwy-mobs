{
	"type": "origins:multiple",
	"item":{
		"type": "origins:action_on_callback",
		"entity_action_gained": {
			"type": "origins:execute_command",
			"command": "item replace entity @s weapon.offhand with farm_and_charm:sturdy_ladder"
		}
	},
	"tick": {
		"type": "origins:action_over_time",
		"interval": 10,
		"entity_action": {
			"type": "origins:chance",
			"chance": 1.0,
			"action": {
				"type": "origins:and",
				"actions": [
					{
						"type": "origins:if_else",
						"condition": {
							"type": "origins:and",
							"conditions": [
								{
									"type": "origins:or",
									"conditions": [
										{
											"type": "origins:and",
											"conditions": [
												{
													"type": "origins:collided_horizontally"
												},
												{
													"type": "origins:resource",
													"resource": "*:*_ground_place_cooldown",
													"comparison": "<=",
													"compare_to": 0
												}
											]
										},
										{
											"type": "origins:in_block",
											"block_condition": {
												"type": "origins:offset",
												"condition": {
													"type": "origins:block",
													"block": "farm_and_charm:sturdy_ladder"
												},
												"y": -1
											}
										}
									]
								},
								{
									"type": "origins:in_block",
									"block_condition": {
										"type": "origins:in_tag",
										"tag": "danilcus:replacable"
									}
								}
							]
						},
						"if_action": {
							"type": "origins:and",
							"actions": [
								{
									"type": "origins:execute_command",
									"command": "setblock ~ ~ ~ farm_and_charm:sturdy_ladder"
								},
								{
									"type": "origins:play_sound",
									"sound": "minecraft:block.ladder.place",
									"volume": 1.0,
									"pitch": 0.8
								},
								{
									"type": "origins:trigger_cooldown",
									"power": "*:*_ground_place_cooldown"
								},
								{
									"type": "origins:swing_hand",
									"hand": "OFF_HAND"
								}
							]
						}
					},
					{
						"type": "origins:if_else",
						"condition": {
							"type": "origins:and",
							"conditions": [
								{
									"type": "origins:in_block",
									"block_condition": {
										"type": "origins:block",
										"block": "farm_and_charm:sturdy_ladder"
									}
								},
								{
									"type": "origins:in_block",
									"block_condition": {
										"type": "origins:offset",
										"condition": {
											"type": "origins:in_tag",
											"tag": "danilcus:replacable"
										},
										"y": 1
									}
								}
							]
						},
						"if_action": {
							"type": "origins:and",
							"actions": [
								{
									"type": "origins:execute_command",
									"command": "setblock ~ ~1 ~ farm_and_charm:sturdy_ladder"
								},
								{
									"type": "origins:play_sound",
									"sound": "minecraft:block.ladder.place",
									"volume": 1.0,
									"pitch": 0.8
								},
								{
									"type": "origins:trigger_cooldown",
									"power": "*:*_ground_place_cooldown"
								},
								{
									"type": "origins:swing_hand",
									"hand": "OFF_HAND"
								}
							]
						}
					}
				]
			}
		}
	},
	"ground_place_cooldown": {
		"type": "origins:cooldown",
		"cooldown": 200
	}
}