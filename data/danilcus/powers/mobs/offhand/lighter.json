{
	"type": "origins:multiple",
	"item":{
		"type": "origins:action_on_callback",
		"entity_action_gained": {
			"type": "origins:execute_command",
			"command": "item replace entity @s weapon.offhand with minecraft:flint_and_steel"
		}
	},
	"tick": {
		"type": "origins:action_over_time",
		"interval": 20,
		"entity_action": {
			"type": "origins:chance",
			"chance": 0.9,
			"action": {
				"type": "origins:if_else",
				"condition": {
					"type": "origins:and",
					"conditions": [
						{
							"type": "origins:predicate",
							"predicate": "danilcus:ai_target"
						},
						{
							"type": "origins:command",
							"command": "execute as @s if block ^ ^1 ^ #minecraft:replaceable",
							"comparison": ">=",
							"compare_to": 1
						}
					]
				},
				"if_action": {
					"type": "origins:and",
					"actions": [
						{
							"type": "origins:execute_command",
							"command": "setblock ^ ^1 ^0.5 minecraft:fire keep"
						},
						{
							"type": "origins:play_sound",
							"sound": "minecraft:item.flintandsteel.use"
						},
						{
							"type": "origins:swing_hand"
						}
					]
				}
			}
		}
	}
}