{
	"type": "origins:multiple",
	"remove": {
		"type": "origins:action_on_callback",
		"entity_action_respawned": {
			"type": "origins:revoke_power",
			"power": "*:*",
			"source": "*:danilcus"
		}
	},
	"death": {
		"type": "origins:action_when_hit",
		"cooldown": 1,
		"damage_condition": {
			"type": "origins:in_tag",
			"tag": "minecraft:is_fire",
			"inverted": true
		},
		"bientity_action": {
			"type": "origins:target_action",
			"action": {
				"type": "origins:if_else",
				"condition": {
					"type": "origins:health",
					"comparison": "<=",
					"compare_to": 0
				},
				"if_action": {
					"type": "origins:and",
					"actions": [
						{
							"type": "origins:execute_command",
							"command": "summon minecraft:cave_spider ^ ^ ^-0.1"
						},
						{
							"type": "origins:chance",
							"chance": 0.5,
							"action": {
								"type": "origins:execute_command",
								"command": "summon minecraft:cave_spider ^0.1 ^ ^0.1"
							}
						},
						{
							"type": "origins:chance",
							"chance": 0.5,
							"action": {
								"type": "origins:execute_command",
								"command": "summon minecraft:cave_spider ^-0.1 ^ ^0.1"
							}
						}
					]
				}
			}
		}
	},
	"tick": {
		"type": "origins:action_over_time",
		"interval": 20,
		"entity_action": {
			"type": "origins:and",
			"actions": [
				{
					"type": "origins:change_resource",
					"resource": "*:*_duration",
					"operation": "add",
					"change": 1
				},
				{
					"type": "origins:chance",
					"chance": 0.05,
					"action": {
						"type": "origins:and",
						"actions": [
							{
								"type": "origins:apply_effect",
								"effect": {
									"id": "minecraft:poison",
									"amplifier": 0,
									"duration": 30,
									"is_ambient": true,
									"show_icon": false,
									"show_particles": false
								}
							},
							{
								"type": "origins:execute_command",
								"command": "playsound minecraft:entity.spider.ambient master @s ~ ~ ~ 100 1.4"
							}
						]
					}
				},
				{
					"type": "origins:chance",
					"chance": 0.05,
					"action": {
						"type": "origins:and",
						"actions": [
							{
								"type": "origins:apply_effect",
								"effect": {
									"id": "minecraft:hunger",
									"amplifier": 50,
									"duration": 40,
									"is_ambient": true,
									"show_icon": false,
									"show_particles": false
								}
							},
							{
								"type": "origins:execute_command",
								"command": "playsound minecraft:entity.spider.step master @s ~ ~ ~ 100 1.4"
							}
						]
					}
				}
			]
		}
	},
	"duration": {
		"type": "origins:resource",
		"min": 0,
		"max": 180,
		"start_value": 0,
		"max_action": {
			"type": "origins:revoke_power",
			"power": "*:*",
			"source": "*:danilcus"
		}
	},
	"particles": {
		"type": "origins:particle",
		"particle": "minecraft:item_cobweb",
		"frequency": 60,
		"count": 1,
		"speed": 0,
		"spread": {
			"x": 0.2,
			"y": 0.3,
			"z": 0.2
		},
		"offset_y": 1,
		"visible_in_first_person": true,
		"visible_while_invisible": false
	}
}